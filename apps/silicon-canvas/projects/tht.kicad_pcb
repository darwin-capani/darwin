(kicad_pcb (version 20221018) (generator pcbnew)
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (37 "F.Mask" user)
    (38 "B.Mask" user)
  )
  (net 0 "")
  (net 1 "GND")
  (footprint "Connector_PinHeader:PinHeader_1x01" (layer "F.Cu") (at 100 100 0)
    (property "Reference" "J1" (at 0 0 0))
    (property "Value" "GND_PIN" (at 0 0 0))
    (pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask")
      (net 1 "GND")))
  (segment (start 100 100) (end 110 100) (width 0.25) (layer "F.Cu") (net 1))
  (segment (start 100 100) (end 100 110) (width 0.25) (layer "B.Cu") (net 1)))
